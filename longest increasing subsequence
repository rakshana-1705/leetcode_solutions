class Solution {
    public int findLengthOfLCIS(int[] nums) {
        int n=nums.length;
        int cnt=1;
        int res=1;
        if(n == 0)
        {
            return 0;
        }
        for(int i=1;i<n;i++)
        {
            if(nums[i-1] < nums[i])
            {
                cnt++;
                res=Math.max(res,cnt);
            }
            else
            {
                cnt = 1;
            }
        }
        return res;
    }
}
